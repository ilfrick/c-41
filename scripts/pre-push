#!/usr/bin/env bash
# Pre-push gate: run the four CI steps before anything reaches GitHub/Gitea.
#
# Install (once, per clone):
#   git config core.hooksPath scripts
#
# Bypass for a genuine emergency:
#   git push --no-verify        (or SKIP_CI_HOOK=1 git push)
#
# Rationale: origin has dual push URLs, so a bad push lands on both remotes at
# once and CI logs are 403 to this account — catching it here is far cheaper
# than reading a red run after the fact.

set -uo pipefail

if [ "${SKIP_CI_HOOK:-0}" = "1" ]; then
  echo "pre-push: SKIP_CI_HOOK=1 — skipping the local CI gate." >&2
  exit 0
fi

# Nothing to check on a delete-only push.
only_deletes=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  if [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
    only_deletes=0
  fi
done
if [ "$only_deletes" = "1" ]; then
  exit 0
fi

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
echo "pre-push: running the four CI steps (bypass with --no-verify) …"
"$HERE/ci-local.sh" || {
  echo >&2
  echo "pre-push: BLOCKED — fix the failures above, or push with --no-verify." >&2
  exit 1
}
